#!/usr/bin/env python3
"""Entrada para cron: ejecuta el orquestador real del pipeline."""

import subprocess
import sys
from pathlib import Path


if __name__ == "__main__":
    script = Path(__file__).with_name("orquestador-sincronizacion")
    raise SystemExit(subprocess.run([sys.executable, str(script), "--run"]).returncode)
