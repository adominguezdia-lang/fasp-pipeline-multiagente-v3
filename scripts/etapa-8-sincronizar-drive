#!/usr/bin/env python3
"""Deprecated compatibility entry point for the old Drive upload flow."""

import sys


MESSAGE = """\
ETAPA 8 esta obsoleta en FASP Pipeline V4.

No uses este comando para publicar en Drive. El flujo V4 separa las acciones
para conservar fileId, SHA y nombres finales sin duplicar ni perder trazabilidad:

1. python3 scripts/actualizar-nombres-drive-desde-manifest --dry-run
2. python3 scripts/actualizar-nombres-drive-desde-manifest
3. python3 scripts/sincronizar-exceles-drive --dry-run
4. python3 scripts/sincronizar-exceles-drive
5. python3 scripts/sincronizar-notebooklm-drive --dry-run
6. python3 scripts/sincronizar-notebooklm-drive

Si un estado quedo incompleto, primero rebaselinea solo ese estado con
scripts/sincronizar-carpeta-drive y vuelve a generar su manifest local.
"""


if __name__ == "__main__":
    print(MESSAGE, file=sys.stderr)
    sys.exit(2)
