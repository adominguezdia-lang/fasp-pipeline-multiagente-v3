#!/usr/bin/env python3
"""
listar_carpetas_drive.py - Lista todas las carpetas en la carpeta FASP raíz
"""

from google.oauth2.credentials import Credentials
from google.auth.transport.requests import Request
from googleapiclient.discovery import build
import json
from pathlib import Path

TOKEN_PATH = Path.home() / ".hermes/google_token.json"
DRIVE_FOLDER_ID = "1fMCP-xvtUfvUMO8h0pMi3V4nFbqnUG85"

def autenticar_drive():
    """Autentica con Google Drive"""
    try:
        if not TOKEN_PATH.exists():
            print(f"❌ Token no encontrado: {TOKEN_PATH}")
            return None
        
        with open(TOKEN_PATH, 'r') as f:
            token_data = json.load(f)
        
        creds = Credentials.from_authorized_user_info(token_data)
        
        if creds.expired and creds.refresh_token:
            print("🔄 Renovando token...")
            creds.refresh(Request())
        
        return build('drive', 'v3', credentials=creds)
    except Exception as e:
        print(f"❌ Error autenticando: {str(e)}")
        return None

def listar_carpetas():
    """Lista todas las carpetas en DRIVE_FOLDER_ID"""
    
    print("\n" + "="*80)
    print("CARPETAS EN DRIVE (09 FASP)")
    print("="*80 + "\n")
    
    service = autenticar_drive()
    if not service:
        return False
    
    try:
        query = f"'{DRIVE_FOLDER_ID}' in parents and mimeType='application/vnd.google-apps.folder' and trashed=false"
        results = service.files().list(
            q=query,
            spaces='drive',
            fields='files(id, name)',
            pageSize=50,
            orderBy='name'
        ).execute()
        
        carpetas = results.get('files', [])
        
        if not carpetas:
            print("❌ No se encontraron carpetas")
            return False
        
        print(f"✅ Encontradas {len(carpetas)} carpetas:\n")
        
        for i, carpeta in enumerate(carpetas, 1):
            print(f"{i:2d}. {carpeta['name']}")
            print(f"    ID: {carpeta['id']}\n")
        
        return True
    
    except Exception as e:
        print(f"❌ Error listando carpetas: {str(e)}")
        return False

if __name__ == "__main__":
    listar_carpetas()
