#!/usr/bin/env python3
"""Sincroniza el corpus local de NotebookLM hacia una carpeta intermedia en Drive."""

from __future__ import annotations

import argparse
import json
import mimetypes
from datetime import datetime
from pathlib import Path

from pipeline_common import read_json, sha256_file, token_path, work_dir, write_json


FOLDER_MIME = "application/vnd.google-apps.folder"
WORK_DIR = work_dir()
TOKEN_PATH = token_path()
FASP_DIR = WORK_DIR / "09 FASP"


def drive_folder_url(folder_id: str | None) -> str | None:
    if not folder_id or folder_id.startswith("dry-run:"):
        return None
    return f"https://drive.google.com/drive/folders/{folder_id}"


def default_run_label() -> str:
    return datetime.now().strftime("%Y-%m-%d_%H%M%S")


def report_links(report: dict) -> dict:
    links = {
        "corpus": None,
        "ejecuciones": None,
        "ejecucion": None,
        "novedades": None,
        "novedades_corrida": None,
    }
    run_label = report.get("novedades_run_label")
    for item in report.get("items", []):
        if item.get("type") != "folder":
            continue
        status = item.get("status", "")
        path = item.get("path")
        name = item.get("name")
        url = drive_folder_url(item.get("drive_id"))
        if not url:
            continue
        if path == "." and not status.startswith("novedad_"):
            links["corpus"] = url
        elif path == "." and status.startswith("novedad_"):
            links["ejecuciones"] = url
            links["novedades"] = url
        elif path == run_label and name == run_label and status.startswith("novedad_"):
            links["ejecucion"] = url
            links["novedades_corrida"] = url
    return links


def authenticate_drive():
    from google.auth.transport.requests import Request
    from google.oauth2.credentials import Credentials
    from googleapiclient.discovery import build

    if not TOKEN_PATH.exists():
        raise FileNotFoundError(f"Token no encontrado: {TOKEN_PATH}")
    with TOKEN_PATH.open(encoding="utf-8") as stream:
        token_data = json.load(stream)
    credentials = Credentials.from_authorized_user_info(token_data)
    if credentials.expired and credentials.refresh_token:
        credentials.refresh(Request())
    return build("drive", "v3", credentials=credentials)


def quote_query_value(value: str) -> str:
    return value.replace("\\", "\\\\").replace("'", "\\'")


def find_child(service, parent_id: str, name: str, mime_type: str | None = None) -> dict | None:
    query = [
        f"'{quote_query_value(parent_id)}' in parents",
        f"name='{quote_query_value(name)}'",
        "trashed=false",
    ]
    if mime_type:
        query.append(f"mimeType='{quote_query_value(mime_type)}'")
    response = service.files().list(
        q=" and ".join(query),
        fields="files(id,name,mimeType,appProperties,size)",
        pageSize=10,
        supportsAllDrives=True,
        includeItemsFromAllDrives=True,
    ).execute()
    files = response.get("files", [])
    if len(files) > 1:
        raise RuntimeError(f"Destino ambiguo en Drive: {name} tiene {len(files)} coincidencias en {parent_id}")
    return files[0] if files else None


def find_child_by_sha(service, parent_id: str, digest: str) -> dict | None:
    query = [
        f"'{quote_query_value(parent_id)}' in parents",
        f"appProperties has {{ key='fasp_sha256' and value='{quote_query_value(digest)}' }}",
        "trashed=false",
    ]
    response = service.files().list(
        q=" and ".join(query),
        fields="files(id,name,mimeType,appProperties,size)",
        pageSize=10,
        supportsAllDrives=True,
        includeItemsFromAllDrives=True,
    ).execute()
    files = response.get("files", [])
    if len(files) > 1:
        raise RuntimeError(f"Destino ambiguo en Drive: SHA {digest} tiene {len(files)} coincidencias en {parent_id}")
    return files[0] if files else None


def ensure_folder(service, parent_id: str, name: str, dry_run: bool) -> tuple[str, str]:
    if dry_run and parent_id.startswith("dry-run:"):
        return f"{parent_id}/{name}", "carpeta_crear"
    existing = find_child(service, parent_id, name, FOLDER_MIME)
    if existing:
        return existing["id"], "carpeta_existente"
    if dry_run:
        return f"dry-run:{parent_id}/{name}", "carpeta_crear"
    created = service.files().create(
        body={"name": name, "mimeType": FOLDER_MIME, "parents": [parent_id]},
        fields="id",
        supportsAllDrives=True,
    ).execute()
    return created["id"], "carpeta_creada"


def iter_local_files(source: Path):
    for path in sorted(source.rglob("*")):
        if path.is_file() and path.name not in {".DS_Store", "notebooklm_drive_manifest.json"}:
            yield path


def content_type(path: Path) -> str:
    guessed, _ = mimetypes.guess_type(path.name)
    return guessed or "application/octet-stream"


def pdf_files(path: Path) -> list[Path]:
    if not path.exists():
        return []
    return sorted(item for item in path.rglob("*.pdf") if item.is_file())


def validate_notebooklm_corpus(source: Path, fasp_dir: Path = FASP_DIR) -> list[dict]:
    if not fasp_dir.exists():
        return []
    missing = []
    for state_dir in sorted(item for item in fasp_dir.iterdir() if item.is_dir()):
        if state_dir.name.startswith("00 "):
            continue
        state_pdfs = pdf_files(state_dir / "01 Normatividad estatal")
        if not state_pdfs:
            continue
        notebook_section = source / state_dir.name / "02_Normativa_Estatal"
        notebook_shas = {sha256_file(path) for path in pdf_files(notebook_section)}
        for pdf in state_pdfs:
            digest = sha256_file(pdf)
            if digest not in notebook_shas:
                try:
                    expected_section = str(notebook_section.relative_to(source))
                except ValueError:
                    expected_section = str(notebook_section)
                missing.append({
                    "state": state_dir.name,
                    "source": str(pdf.relative_to(fasp_dir)),
                    "expected_section": expected_section,
                    "sha256": digest,
                })
    return missing


def assert_notebooklm_corpus_current(source: Path, fasp_dir: Path = FASP_DIR) -> None:
    missing = validate_notebooklm_corpus(source, fasp_dir)
    if not missing:
        return
    examples = "\n".join(f"- {item['source']}" for item in missing[:10])
    extra = "" if len(missing) <= 10 else f"\n- ... y {len(missing) - 10} más"
    raise RuntimeError(
        "Corpus NotebookLM local incompleto: hay PDFs estatales en 09 FASP que no existen "
        "en notebooklm/<estado>/02_Normativa_Estatal.\n"
        "Ejecuta primero: python3 scripts/preparar-notebooklm-por-estado\n"
        f"Faltantes detectados: {len(missing)}\n{examples}{extra}"
    )


def build_folder_map(service, source: Path, root_folder_id: str, dry_run: bool) -> tuple[dict[Path, str], list[dict]]:
    folder_ids = {Path("."): root_folder_id}
    actions = []
    for folder in sorted(path for path in source.rglob("*") if path.is_dir()):
        relative = folder.relative_to(source)
        parent_relative = relative.parent
        parent_id = folder_ids[parent_relative]
        folder_id, status = ensure_folder(service, parent_id, folder.name, dry_run)
        folder_ids[relative] = folder_id
        actions.append({"type": "folder", "path": str(relative), "status": status, "drive_id": folder_id})
    return folder_ids, actions


def sync_file(service, path: Path, source: Path, parent_id: str, dry_run: bool) -> dict:
    relative = path.relative_to(source)
    digest = sha256_file(path)
    mime_type = content_type(path)
    existing = None if dry_run and parent_id.startswith("dry-run:") else find_child(service, parent_id, path.name)
    result = {
        "type": "file",
        "path": str(relative),
        "name": path.name,
        "sha256": digest,
        "mimeType": mime_type,
    }
    if existing and existing.get("appProperties", {}).get("fasp_sha256") == digest:
        if existing.get("name") != path.name:
            if dry_run:
                result.update({"status": "renombrar", "drive_id": existing["id"], "previous_name": existing.get("name")})
                return result
            updated = service.files().update(
                fileId=existing["id"],
                body={"name": path.name, "appProperties": {"fasp_sha256": digest, "fasp_source": "notebooklm"}},
                fields="id,name,appProperties",
                supportsAllDrives=True,
            ).execute()
            result.update({"status": "renombrado", "drive_id": updated["id"], "previous_name": existing.get("name")})
            return result
        result.update({"status": "sin_cambios", "drive_id": existing["id"]})
        return result

    existing_by_sha = None if dry_run and parent_id.startswith("dry-run:") else find_child_by_sha(service, parent_id, digest)
    if existing_by_sha and not existing:
        if dry_run:
            result.update({"status": "renombrar", "drive_id": existing_by_sha["id"], "previous_name": existing_by_sha.get("name")})
            return result
        updated = service.files().update(
            fileId=existing_by_sha["id"],
            body={"name": path.name, "appProperties": {"fasp_sha256": digest, "fasp_source": "notebooklm"}},
            fields="id,name,appProperties",
            supportsAllDrives=True,
        ).execute()
        result.update({"status": "renombrado", "drive_id": updated["id"], "previous_name": existing_by_sha.get("name")})
        return result

    if dry_run:
        result.update({"status": "actualizar" if existing else "subir", "drive_id": existing.get("id") if existing else None})
        return result

    from googleapiclient.http import MediaFileUpload

    media = MediaFileUpload(str(path), mimetype=mime_type, resumable=True)
    body = {"name": path.name, "appProperties": {"fasp_sha256": digest, "fasp_source": "notebooklm"}}
    if existing:
        updated = service.files().update(
            fileId=existing["id"],
            body=body,
            media_body=media,
            fields="id,name,appProperties",
            supportsAllDrives=True,
        ).execute()
        result.update({"status": "actualizado", "drive_id": updated["id"]})
    else:
        body["parents"] = [parent_id]
        created = service.files().create(
            body=body,
            media_body=media,
            fields="id,name,appProperties",
            supportsAllDrives=True,
        ).execute()
        result.update({"status": "subido", "drive_id": created["id"]})
    return result


def novelty_candidates(actions: list[dict]) -> list[dict]:
    return [
        item for item in actions
        if item.get("type") == "file"
        and item.get("status") in {"subir", "actualizar", "renombrar", "subido", "actualizado", "renombrado"}
        and Path(item.get("path", "")).suffix.lower() == ".pdf"
    ]


def build_needed_folder_map(
    service,
    source: Path,
    root_folder_id: str,
    file_records: list[dict],
    dry_run: bool,
) -> tuple[dict[Path, str], list[dict]]:
    folder_ids = {Path("."): root_folder_id}
    actions = []
    needed = sorted({Path(record["path"]).parent for record in file_records if Path(record["path"]).parent != Path(".")})
    for relative in needed:
        for folder in reversed([relative, *relative.parents]):
            if folder == Path(".") or folder in folder_ids:
                continue
            parent_id = folder_ids[folder.parent]
            folder_id, status = ensure_folder(service, parent_id, folder.name, dry_run)
            folder_ids[folder] = folder_id
            actions.append({"type": "folder", "path": str(folder), "status": f"novedad_{status}", "drive_id": folder_id})
    return folder_ids, actions


def sync_novelties(
    service,
    source: Path,
    parent_id: str,
    root_name: str,
    run_label: str,
    main_actions: list[dict],
    dry_run: bool,
) -> list[dict]:
    candidates = novelty_candidates(main_actions)
    root_id, root_status = ensure_folder(service, parent_id, root_name, dry_run)
    run_id, run_status = ensure_folder(service, root_id, run_label, dry_run)
    folder_ids, actions = build_needed_folder_map(service, source, run_id, candidates, dry_run)
    actions.insert(0, {"type": "folder", "path": ".", "status": f"novedad_{root_status}", "drive_id": root_id, "name": root_name})
    actions.insert(1, {"type": "folder", "path": run_label, "status": f"novedad_{run_status}", "drive_id": run_id, "name": run_label})
    for candidate in candidates:
        path = source / candidate["path"]
        parent_relative = Path(candidate["path"]).parent
        item = sync_file(service, path, source, folder_ids[parent_relative], dry_run)
        item["status"] = f"novedad_{item['status']}"
        actions.append(item)
    return actions


def sync_tree(
    service,
    source: Path,
    root_name: str,
    parent_id: str,
    dry_run: bool,
    novedades_root_name: str,
    run_label: str,
    create_novelties: bool,
) -> dict:
    if not source.exists():
        raise FileNotFoundError(f"No existe el corpus NotebookLM local: {source}")
    root_id, root_status = ensure_folder(service, parent_id, root_name, dry_run)
    folder_ids, actions = build_folder_map(service, source, root_id, dry_run)
    actions.insert(0, {"type": "folder", "path": ".", "status": root_status, "drive_id": root_id, "name": root_name})
    for path in iter_local_files(source):
        relative_parent = path.relative_to(source).parent
        actions.append(sync_file(service, path, source, folder_ids[relative_parent], dry_run))
    novelty_actions = []
    if create_novelties:
        novelty_actions = sync_novelties(service, source, parent_id, novedades_root_name, run_label, actions, dry_run)
    summary = {
        "timestamp": datetime.now().isoformat(),
        "dry_run": dry_run,
        "source": str(source),
        "drive_root_name": root_name,
        "novedades_root_name": novedades_root_name,
        "novedades_run_label": run_label,
        "drive_parent_id": parent_id,
        "status_counts": {},
        "items": actions + novelty_actions,
    }
    for item in summary["items"]:
        summary["status_counts"][item["status"]] = summary["status_counts"].get(item["status"], 0) + 1
    summary["links"] = report_links(summary)
    return summary


def main() -> int:
    parser = argparse.ArgumentParser(description="Sube o actualiza el corpus local NotebookLM en Drive.")
    parser.add_argument("--source", type=Path, default=WORK_DIR / "notebooklm")
    parser.add_argument("--drive-root-name", default="FASP_NBLM")
    parser.add_argument("--novedades-root-name", default="FASP_NBLM_NOVEDADES")
    parser.add_argument("--run-label", default=default_run_label())
    parser.add_argument("--no-novedades", action="store_true")
    parser.add_argument("--skip-corpus-validation", action="store_true")
    parser.add_argument("--parent-id", default="root", help="Carpeta padre en Drive; por defecto, Mi unidad.")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    if not args.skip_corpus_validation:
        assert_notebooklm_corpus_current(args.source)

    service = authenticate_drive()
    report = sync_tree(
        service,
        args.source,
        args.drive_root_name,
        args.parent_id,
        args.dry_run,
        args.novedades_root_name,
        args.run_label,
        not args.no_novedades,
    )
    suffix = "dry_run" if args.dry_run else "aplicado"
    write_json(WORK_DIR / "logs" / f"notebooklm_drive_{suffix}_{datetime.now():%Y%m%d_%H%M%S}.json", report)
    write_json(WORK_DIR / "notebooklm" / "notebooklm_drive_manifest.json", report)
    print(json.dumps({
        "status_counts": report["status_counts"],
        "links": report["links"],
    }, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
