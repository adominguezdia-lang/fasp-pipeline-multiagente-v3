#!/usr/bin/env python3
"""Ejecuta etapas 0-4 para un estado sin compartir salidas con otros estados."""

import argparse
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import List

from pipeline_common import work_dir, write_json


WORK_DIR = work_dir()
SCRIPTS_DIR = Path(__file__).parent


def slug(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")


def run_stage(name: str, script: str, arguments: List[object]) -> dict:
    result = subprocess.run([sys.executable, str(SCRIPTS_DIR / script), *map(str, arguments)], text=True, capture_output=True)
    if result.stdout:
        print(result.stdout, end="")
    if result.returncode:
        print(result.stderr, file=sys.stderr, end="")
    return {"name": name, "status": "COMPLETADA" if result.returncode == 0 else "FALLO", "returncode": result.returncode, "stderr": result.stderr[-2000:]}


def pipeline_state(state_name: str, skip_sync: bool = False) -> int:
    identifier = slug(state_name)
    source = WORK_DIR / "09 FASP" / state_name
    corpus = WORK_DIR / "corpusintegrado" / identifier
    distribution = WORK_DIR / "corpus_por_estado_v2" / identifier
    spreadsheets = WORK_DIR / "exceles" / identifier
    stages = ([] if skip_sync else [
        ("ETAPA 0", "sincronizar-carpeta-drive", [state_name]),
    ]) + [
        ("ETAPA 1A", "analizar-y-versionar-pdfs", ["--source", source]),
        ("ETAPA 1", "etapa-1-renombrado", ["--source", source]),
        ("ETAPA 2", "etapa-2-extraccion-exceles", ["--source", source, "--output", spreadsheets]),
        ("ETAPA 3", "etapa-3-integracion-corpusintegrado", ["--source", source, "--output", corpus]),
        ("ETAPA 4", "etapa-4-distribucion-por-estado", ["--source", corpus, "--output", distribution]),
    ]
    results = []
    for name, script, arguments in stages:
        result = run_stage(name, script, arguments)
        results.append(result)
        if result["status"] != "COMPLETADA":
            break
    report = {"timestamp": datetime.now().isoformat(), "state": state_name, "output": {"corpus": str(corpus), "distribution": str(distribution), "spreadsheets": str(spreadsheets)}, "stages": results}
    write_json(WORK_DIR / "logs" / f"pipeline_{identifier}_{datetime.now():%Y%m%d_%H%M%S}.json", report)
    return 0 if len(results) == len(stages) and all(item["status"] == "COMPLETADA" for item in results) else 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Procesa un estado con entradas y salidas aisladas.")
    parser.add_argument("state")
    parser.add_argument("--skip-sync", action="store_true", help="Usar sólo después de sincronizar el estado.")
    args = parser.parse_args()
    return pipeline_state(args.state, args.skip_sync)


if __name__ == "__main__":
    raise SystemExit(main())
