#!/usr/bin/env python3
"""ETAPA 2: extrae metadatos reales de PDFs y genera cuatro libros Excel."""

import argparse
import re
import unicodedata
from datetime import datetime
from pathlib import Path
from typing import List

from openpyxl import Workbook
from openpyxl.styles import Font

from pipeline_common import content_label, sha256_file, work_dir


WORK_DIR = work_dir()
FASP_LOCAL = WORK_DIR / "09 FASP"
EXCELES_DIR = WORK_DIR / "exceles"
COMMON_DIR = FASP_LOCAL / "00 Bibliografía y normatividad federal"
STATE_CODES = {"MEX": "EdoMex", "HID": "Hidalgo", "QRO": "Queretaro", "MIC": "Michoacan", "CHI": "Chiapas", "TAB": "Tabasco", "TAM": "Tamaulipas", "ZAC": "Zacatecas"}


def classify(filename: str) -> str:
    upper = filename.upper()
    if "_BIB-" in upper:
        return "Bibliografia"
    if "_NAL_" in upper or "_NORFED" in upper:
        return "Normatividad Federal"
    if "_TDR-" in upper:
        return "TDR"
    if any(f"_{code}_" in upper for code in STATE_CODES):
        return "Normatividad Estatal"
    return "Otros"


def state(filename: str) -> str:
    upper = filename.upper()
    return next((name for code, name in STATE_CODES.items() if f"_{code}_" in upper), "Federal")


def clean_metadata_value(value: str | None) -> str:
    return re.sub(r"\s+", " ", value or "").strip()


def clean_pdf_date(value: str | None) -> str:
    value = clean_metadata_value(value)
    match = re.match(r"D:(\d{4})(\d{2})?(\d{2})?", value)
    if not match:
        return value
    year, month, day = match.groups()
    if month and day:
        return f"{year}-{month}-{day}"
    if month:
        return f"{year}-{month}"
    return year


def filename_title(path: Path) -> str:
    stem = re.sub(r"_V\d+(?:\.\d+)?$", "", path.stem, flags=re.IGNORECASE)
    stem = re.sub(r"^FASP_\d{4}_P\d+_", "", stem, flags=re.IGNORECASE)
    stem = re.sub(r"^(NAL|MEX|HID|QRO|MIC|CHI|TAB|TAM|ZAC)_", "", stem, flags=re.IGNORECASE)
    stem = re.sub(r"^(BIB|NORFED|NOR|DOC|TDR)[-_]?", "", stem, flags=re.IGNORECASE)
    text = unicodedata.normalize("NFKD", stem).encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[_-]+", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text.title() if text else path.stem


def inferred_title(path: Path, metadata_title: str, text: str) -> tuple[str, str]:
    metadata_title = clean_metadata_value(metadata_title)
    if metadata_title:
        return metadata_title, "metadatos_pdf"
    label = content_label(text, "")
    if label != "CONTENIDO_SIN_TITULO":
        return label.replace("_", " ").title(), "texto_pdf"
    return filename_title(path), "nombre_archivo"


def metadata(path: Path) -> dict:
    try:
        import fitz
    except ImportError as error:
        raise RuntimeError("Falta PyMuPDF; instala la dependencia 'pymupdf'.") from error
    with fitz.open(path) as document:
        document_metadata = document.metadata or {}
        text_blocks = []
        for page_index in range(min(document.page_count, 3)):
            text = document[page_index].get_text("text").replace("\n", " ").strip()
            if text:
                text_blocks.append(text)
        extracted_text = " ".join(text_blocks)
        preview = re.sub(r"\s+", " ", extracted_text).strip()[:800]
        title, title_source = inferred_title(path, document_metadata.get("title", ""), extracted_text)
        return {
            "paginas": document.page_count,
            "titulo": title,
            "fuente_titulo": title_source,
            "autor": clean_metadata_value(document_metadata.get("author", "")) or "No identificado",
            "fecha": clean_pdf_date(document_metadata.get("creationDate", "")),
            "extracto": preview,
            "estado_texto": "con_texto" if preview else "sin_texto_extraible",
        }


def save_workbook(path: Path, title: str, headers: List[str], rows: List[List[str]]) -> None:
    workbook = Workbook()
    worksheet = workbook.active
    worksheet.title = title[:31]
    worksheet.append(headers)
    for cell in worksheet[1]:
        cell.font = Font(bold=True)
    for row in rows:
        worksheet.append(row)
    worksheet.freeze_panes = "A2"
    for column in worksheet.columns:
        letter = column[0].column_letter
        worksheet.column_dimensions[letter].width = min(max(len(str(cell.value or "")) for cell in column) + 2, 60)
    workbook.save(path)


def input_pdfs(source: Path, include_common: bool = False) -> list[Path]:
    roots = [source]
    if include_common:
        roots = [
            COMMON_DIR / "01 Bibliografía",
            COMMON_DIR / "02 Normatividad federal",
            source,
        ]
    seen = set()
    files = []
    for root in roots:
        if not root.exists():
            continue
        for pdf in sorted(root.rglob("*.pdf")):
            digest = sha256_file(pdf)
            if digest in seen:
                continue
            seen.add(digest)
            files.append(pdf)
    return files


def extract(source: Path, output: Path, include_common: bool = False) -> int:
    if not source.exists():
        raise FileNotFoundError(f"Directorio fuente no existe: {source}")
    output.mkdir(parents=True, exist_ok=True)
    records = []
    for pdf in input_pdfs(source, include_common):
        data = metadata(pdf)
        records.append({"path": pdf, "category": classify(pdf.name), "state": state(pdf.name), **data})
    headers = ["Archivo PDF", "Categoria", "Estado", "Paginas", "Tamano KB", "Titulo", "Fuente Titulo", "Autor PDF", "Fecha PDF", "Estado Texto", "Extracto", "SHA256", "Ruta"]
    rows = [[r["path"].name, r["category"], r["state"], r["paginas"], round(r["path"].stat().st_size / 1024, 1), r["titulo"], r["fuente_titulo"], r["autor"], r["fecha"], r["estado_texto"], r["extracto"], sha256_file(r["path"]), str(r["path"])] for r in records]
    save_workbook(output / "00_CORPUS_MAESTRO.xlsx", "Corpus Maestro", headers, rows)
    for category, filename in (("Bibliografia", "01_bibliografia.xlsx"), ("Normatividad Federal", "02_normatividad_federal.xlsx"), ("Normatividad Estatal", "03_normatividad_estatal.xlsx")):
        selected = [row for row, record in zip(rows, records) if record["category"] == category]
        save_workbook(output / filename, category, headers, selected)
    return len(records)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", type=Path, default=FASP_LOCAL)
    parser.add_argument("--output", type=Path, default=EXCELES_DIR)
    parser.add_argument("--include-common", action="store_true", help="Incluye bibliografía y normativa federal común al generar Excel por estado.")
    args = parser.parse_args()
    try:
        count = extract(args.source, args.output, args.include_common)
    except (OSError, RuntimeError) as error:
        print(f"ERROR: {error}")
        return 1
    print(f"ETAPA 2 completada: {count} PDFs analizados; 4 Exceles generados")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
