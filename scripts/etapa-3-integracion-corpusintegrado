#!/usr/bin/env python3
"""ETAPA 3: construye un corpus PDF reproducible y sin colisiones."""

import argparse
import shutil
from datetime import datetime
from pathlib import Path

from pipeline_common import sha256_file, work_dir, write_json


WORK_DIR = work_dir()
FASP_LOCAL = WORK_DIR / "09 FASP"
CORPUS_DIR = WORK_DIR / "corpusintegrado"
LOG_FILE = WORK_DIR / "logs" / f"etapa_3_{datetime.now():%Y%m%d_%H%M%S}.log"


def log_msg(message, level="INFO"):
    line = f"[{datetime.now():%H:%M:%S}] {level}: {message}"
    print(line)
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as stream:
        stream.write(line + "\n")


def build_plan(source: Path):
    files = sorted(path for path in source.rglob("*.pdf") if path.is_file())
    by_sha = {}
    for path in files:
        digest = sha256_file(path)
        current = by_sha.get(digest)
        if not current or len(path.name) < len(current.name):
            by_sha[digest] = path
    files = sorted(by_sha.values())
    names = {}
    for path in files:
        names.setdefault(path.name, []).append(path)
    collisions = {name: paths for name, paths in names.items() if len(paths) > 1}
    if collisions:
        details = "; ".join(f"{name}: {', '.join(str(p.relative_to(source)) for p in paths)}" for name, paths in collisions.items())
        raise ValueError(f"Nombres duplicados en origen; no se puede crear un corpus plano: {details}")
    return files


def integrate(source: Path, output: Path, dry_run: bool = False) -> int:
    if not source.exists():
        raise FileNotFoundError(f"Directorio fuente no existe: {source}")
    files = build_plan(source)
    log_msg(f"PDFs validados para integrar: {len(files)}")
    if dry_run:
        return len(files)

    if output.exists():
        backup = output.parent / ".archive" / f"corpus_backup_{datetime.now():%Y%m%d_%H%M%S}"
        existing = [path for path in output.iterdir() if path.is_file()]
        if existing:
            backup.mkdir(parents=True, exist_ok=True)
            for path in existing:
                shutil.copy2(path, backup / path.name)
        for path in existing:
            path.unlink()
    output.mkdir(parents=True, exist_ok=True)

    manifest_files = []
    for source_file in files:
        destination = output / source_file.name
        shutil.copy2(source_file, destination)
        manifest_files.append({
            "name": destination.name,
            "source": str(source_file.relative_to(source)),
            "sha256": sha256_file(destination),
            "bytes": destination.stat().st_size,
        })
    write_json(output / "manifest.json", {
        "timestamp": datetime.now().isoformat(),
        "total_pdfs": len(manifest_files),
        "source": str(source),
        "files": manifest_files,
    })
    return len(manifest_files)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", type=Path, default=FASP_LOCAL)
    parser.add_argument("--output", type=Path, default=CORPUS_DIR)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    try:
        count = integrate(args.source, args.output, args.dry_run)
    except (OSError, ValueError) as error:
        log_msg(str(error), "ERROR")
        return 1
    log_msg(f"Corpus integrado: {count} PDFs")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
