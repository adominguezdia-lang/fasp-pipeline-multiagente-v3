#!/usr/bin/env python3
"""
ETAPA 1: RENOMBRADO DE PDFs
Normaliza y estandariza los nombres de archivos PDF
"""

from pathlib import Path
from datetime import datetime
import re
import os

# ============================================================================
# CONFIGURACIÓN
# ============================================================================
WORK_DIR = Path("/Users/adominguezdia/Documents/FASP")
FASP_LOCAL = WORK_DIR / "09 FASP"
PDF_DIR = WORK_DIR / "PDF_Procesados"
LOG_DIR = WORK_DIR / "logs"
LOG_FILE = LOG_DIR / f"etapa_1_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"

# ============================================================================
# UTILIDADES
# ============================================================================
def log_msg(msg, nivel="INFO"):
    """Registra mensajes en log y consola"""
    timestamp = datetime.now().strftime("%H:%M:%S")
    line = f"[{timestamp}] {nivel}: {msg}"
    print(line)
    LOG_DIR.mkdir(exist_ok=True)
    with open(LOG_FILE, 'a') as f:
        f.write(line + "\n")

def normalize_filename(filename):
    """Normaliza nombres de archivo PDF"""
    # Remover extensión temporalmente
    name, ext = os.path.splitext(filename)
    
    # Aplicar normalizaciones
    # 1. Reemplazar espacios múltiples por guión
    normalized = re.sub(r'\s+', '_', name)
    
    # 2. Remover caracteres especiales inválidos
    normalized = re.sub(r'[^\w\-_]', '', normalized)
    
    # 3. Convertir a mayúsculas para consistencia
    normalized = normalized.upper()
    
    # 4. Remover guiones duplicados
    normalized = re.sub(r'_+', '_', normalized)
    
    return normalized + ext

def process_pdfs(source_dir):
    """Procesa renombrado de PDFs en directorio"""
    if not source_dir.exists():
        log_msg(f"⚠️  Directorio no existe: {source_dir}", "WARN")
        return 0, []
    
    pdf_files = list(source_dir.rglob("*.pdf"))
    processed = 0
    errors = []
    renamed_files = []
    
    for pdf_file in pdf_files:
        try:
            old_name = pdf_file.name
            new_name = normalize_filename(old_name)
            
            if old_name != new_name:
                new_path = pdf_file.parent / new_name
                
                # Evitar duplicados - si la versión normalizada ya existe, eliminar la antigua
                if new_path.exists() and new_path != pdf_file:
                    log_msg(f"🗑️  Eliminando archivo duplicado (forma antigua): {old_name}", "DEBUG")
                    pdf_file.unlink()  # Eliminar la versión antigua sin normalizar
                    processed += 1
                    continue
                
                # Renombrar
                pdf_file.rename(new_path)
                log_msg(f"✓ {old_name} -> {new_name}")
                renamed_files.append((old_name, new_name))
                processed += 1
            else:
                log_msg(f"~ {old_name} (sin cambios)", "DEBUG")
                processed += 1
                
        except Exception as e:
            error_msg = f"Error procesando {pdf_file.name}: {str(e)}"
            log_msg(f"❌ {error_msg}", "ERROR")
            errors.append(error_msg)
    
    return processed, errors, renamed_files

# ============================================================================
# MAIN
# ============================================================================
def main():
    print("\n" + "="*80)
    print("ETAPA 1: RENOMBRADO DE PDFs")
    print("="*80)
    
    try:
        log_msg("Iniciando ETAPA 1...")
        log_msg(f"Directorio fuente: {FASP_LOCAL}")
        
        # Crear directorio de salida si no existe
        PDF_DIR.mkdir(parents=True, exist_ok=True)
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        
        # Procesar PDFs
        processed_count, errors, renamed = process_pdfs(FASP_LOCAL)
        
        # Resumen
        print("\n" + "="*80)
        print("RESUMEN ETAPA 1")
        print("="*80)
        log_msg(f"Archivos procesados: {processed_count}")
        log_msg(f"Archivos renombrados: {len(renamed)}")
        log_msg(f"Errores encontrados: {len(errors)}")
        
        if errors:
            log_msg("⚠️  ERRORES DETECTADOS:", "WARN")
            for error in errors:
                log_msg(f"  - {error}", "WARN")
        
        # Estado final
        if len(errors) == 0:
            estado = "✅ EXITOSO"
        elif len(errors) < len(renamed) / 2:
            estado = "⚠️  PARCIAL"
        else:
            estado = "❌ FALLIDO"
        
        log_msg(f"Estado final: {estado}")
        
        # Formato de salida requerido
        print("\n" + "="*80)
        print("[ETAPA] | [ARCHIVOS_PROCESADOS] | [ERRORES] | [ESTADO]")
        print("="*80)
        print(f"ETAPA_1 | {processed_count} | {len(errors)} | {estado}")
        
        print(f"\n✅ ETAPA 1 FINALIZADA")
        print(f"Log guardado: {LOG_FILE}")
        
        return 0 if len(errors) == 0 else 1
        
    except Exception as e:
        log_msg(f"❌ Error fatal en ETAPA 1: {str(e)}", "ERROR")
        print(f"\n[ETAPA] | [ARCHIVOS_PROCESADOS] | [ERRORES] | [ESTADO]")
        print(f"ETAPA_1 | 0 | 1 | ❌ FALLIDO")
        raise

if __name__ == "__main__":
    exit(main())
