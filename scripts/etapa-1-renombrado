#!/usr/bin/env python3
"""ETAPA 1: normaliza nombres de PDFs sin descartar documentos."""

import argparse
import os
import re
import unicodedata
from datetime import datetime
from pathlib import Path

from pipeline_common import sha256_file, work_dir


WORK_DIR = work_dir()
FASP_LOCAL = WORK_DIR / "09 FASP"
LOG_DIR = WORK_DIR / "logs"
LOG_FILE = LOG_DIR / f"etapa_1_{datetime.now():%Y%m%d_%H%M%S}.log"


def log_msg(message, level="INFO"):
    line = f"[{datetime.now():%H:%M:%S}] {level}: {message}"
    print(line)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as stream:
        stream.write(line + "\n")


def normalize_filename(filename: str) -> str:
    name, extension = os.path.splitext(filename)
    normalized = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode("ascii")
    normalized = re.sub(r"\s+", "_", normalized)
    normalized = re.sub(r"[^A-Za-z0-9_.-]", "", normalized).upper()
    normalized = re.sub(r"_+", "_", normalized).strip("_")
    return normalized + extension.lower()


def collision_name(target: Path, source: Path) -> Path:
    suffix = 2
    candidate = target.with_name(f"{target.stem}_COPIA-{suffix}{target.suffix}")
    while candidate.exists() and sha256_file(candidate) != sha256_file(source):
        suffix += 1
        candidate = target.with_name(f"{target.stem}_COPIA-{suffix}{target.suffix}")
    return candidate


def process_pdfs(source_dir: Path, dry_run: bool = False):
    if not source_dir.exists():
        raise FileNotFoundError(f"Directorio no existe: {source_dir}")

    processed = 0
    renamed = []
    errors = []
    for pdf_file in sorted(source_dir.rglob("*.pdf")):
        processed += 1
        target = pdf_file.with_name(normalize_filename(pdf_file.name))
        if target == pdf_file:
            continue
        try:
            if target.exists():
                if sha256_file(pdf_file) == sha256_file(target):
                    log_msg(f"Duplicado idéntico conservado: {pdf_file.name}", "WARN")
                    continue
                target = collision_name(target, pdf_file)
                log_msg(f"Colisión de nombre; se conserva como {target.name}", "WARN")
            if not dry_run:
                pdf_file.rename(target)
            renamed.append((pdf_file.name, target.name))
        except OSError as error:
            errors.append(f"{pdf_file}: {error}")
            log_msg(errors[-1], "ERROR")
    return processed, renamed, errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", type=Path, default=FASP_LOCAL)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    try:
        processed, renamed, errors = process_pdfs(args.source, args.dry_run)
    except OSError as error:
        log_msg(str(error), "ERROR")
        return 1

    log_msg(f"Procesados: {processed}; renombrados: {len(renamed)}; errores: {len(errors)}")
    return 0 if not errors else 1


if __name__ == "__main__":
    raise SystemExit(main())
