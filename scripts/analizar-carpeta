#!/usr/bin/env python3
"""
analizar_carpeta.py - Analiza completitud de UNA carpeta (Drive vs Local)
Uso: python3 analizar_carpeta.py "nombre_carpeta"
"""

import sys
from google.oauth2.credentials import Credentials
from google.auth.transport.requests import Request
from googleapiclient.discovery import build
import json
from pathlib import Path
from datetime import datetime
from collections import defaultdict

TOKEN_PATH = Path.home() / ".hermes/google_token.json"
FASP_LOCAL = Path("/Users/adominguezdia/Documents/FASP/09 FASP")
DRIVE_FOLDER_ID = "1fMCP-xvtUfvUMO8h0pMi3V4nFbqnUG85"

def log_msg(msg, nivel="INFO"):
    timestamp = datetime.now().strftime("%H:%M:%S")
    line = f"[{timestamp}] {nivel}: {msg}"
    print(line)

def autenticar_drive():
    """Autentica con Google Drive"""
    try:
        if not TOKEN_PATH.exists():
            log_msg(f"❌ Token no encontrado: {TOKEN_PATH}", "ERROR")
            return None
        
        with open(TOKEN_PATH, 'r') as f:
            token_data = json.load(f)
        
        creds = Credentials.from_authorized_user_info(token_data)
        
        if creds.expired and creds.refresh_token:
            log_msg("🔄 Renovando token...")
            creds.refresh(Request())
        
        return build('drive', 'v3', credentials=creds)
    except Exception as e:
        log_msg(f"❌ Error autenticando: {str(e)}", "ERROR")
        return None

def buscar_carpeta(service, carpeta_nombre):
    """Busca una carpeta por nombre"""
    try:
        query = f"'{DRIVE_FOLDER_ID}' in parents and name='{carpeta_nombre}' and mimeType='application/vnd.google-apps.folder' and trashed=false"
        results = service.files().list(
            q=query,
            spaces='drive',
            fields='files(id, name)',
            pageSize=10
        ).execute()
        
        items = results.get('files', [])
        return items[0] if items else None
    except Exception as e:
        log_msg(f"❌ Error buscando carpeta: {str(e)}", "ERROR")
        return None

def listar_archivos_por_subcarpeta_drive(service, parent_id, carpeta_name=""):
    """Lista archivos organizados por subcarpeta en Drive"""
    estructura = defaultdict(list)
    
    try:
        query = f"'{parent_id}' in parents and trashed=false"
        page_token = None
        
        while True:
            results = service.files().list(
                q=query,
                spaces='drive',
                fields='files(id, name, mimeType, size)',
                pageSize=1000,
                pageToken=page_token
            ).execute()
            
            items = results.get('files', [])
            
            for item in items:
                if item['mimeType'] == 'application/vnd.google-apps.folder':
                    # Es carpeta - recursión
                    subfolder = listar_archivos_por_subcarpeta_drive(service, item['id'], item['name'])
                    for key, val in subfolder.items():
                        estructura[f"{item['name']}/{key}" if key else item['name']] = val
                else:
                    # Es archivo
                    subcarpeta = item['name']
                    estructura[subcarpeta].append({
                        'name': item['name'],
                        'size': int(item.get('size', 0))
                    })
            
            page_token = results.get('nextPageToken')
            if not page_token:
                break
    
    except Exception as e:
        log_msg(f"❌ Error listando: {str(e)}", "ERROR")
    
    return estructura

def obtener_archivos_locales(carpeta_path):
    """Obtiene archivos locales por subcarpeta"""
    estructura = defaultdict(list)
    
    if not carpeta_path.exists():
        return estructura
    
    for archivo in carpeta_path.rglob("*"):
        if archivo.is_file():
            rel_path = archivo.relative_to(carpeta_path)
            subcarpeta = str(rel_path.parent)
            estructura[subcarpeta].append({
                'name': archivo.name,
                'size': archivo.stat().st_size
            })
    
    return estructura

def analizar_carpeta(carpeta_nombre):
    """Analiza una carpeta específica"""
    
    print("\n" + "="*100)
    print(f"ANÁLISIS DE COMPLETITUD: {carpeta_nombre}")
    print("="*100 + "\n")
    
    # Autenticar
    log_msg("🔐 Autenticando...")
    service = autenticar_drive()
    if not service:
        return False
    
    # Buscar carpeta en Drive
    log_msg(f"🔍 Buscando carpeta '{carpeta_nombre}' en Drive...")
    carpeta_drive = buscar_carpeta(service, carpeta_nombre)
    if not carpeta_drive:
        log_msg(f"❌ Carpeta no encontrada en Drive", "ERROR")
        return False
    
    log_msg(f"✅ Encontrada en Drive (ID: {carpeta_drive['id']})")
    
    # Obtener archivos en Drive
    log_msg("📋 Listando archivos en Drive...")
    archivos_drive = listar_archivos_por_subcarpeta_drive(service, carpeta_drive['id'])
    total_drive = sum(len(archivos) for archivos in archivos_drive.values())
    log_msg(f"✅ Encontrados {total_drive} archivos en {len(archivos_drive)} subcarpetas")
    
    # Obtener archivos locales
    log_msg("📁 Escaneando carpeta local...")
    carpeta_local = FASP_LOCAL / carpeta_nombre
    archivos_locales = obtener_archivos_locales(carpeta_local)
    total_local = sum(len(archivos) for archivos in archivos_locales.values())
    log_msg(f"✅ Encontrados {total_local} archivos en {len(archivos_locales)} subcarpetas")
    
    # Mostrar resumen
    print(f"\n{'='*100}")
    print("RESUMEN GENERAL")
    print(f"{'='*100}")
    print(f"Drive:  {total_drive} archivos en {len(archivos_drive)} niveles")
    print(f"Local:  {total_local} archivos en {len(archivos_locales)} niveles")
    print(f"\n{'Diferencia':<20}: {total_drive - total_local} archivos")
    
    # Análisis detallado
    print(f"\n{'='*100}")
    print("DETALLE POR SUBCARPETA")
    print(f"{'='*100}\n")
    
    todas_subcarpetas = sorted(set(list(archivos_drive.keys()) + list(archivos_locales.keys())))
    
    faltantes_totales = []
    completo = True
    
    for subcarpeta in todas_subcarpetas:
        archivos_d = archivos_drive.get(subcarpeta, [])
        archivos_l = archivos_locales.get(subcarpeta, [])
        
        count_d = len(archivos_d)
        count_l = len(archivos_l)
        
        status = "✅" if count_d == count_l else "❌"
        
        print(f"{status} {subcarpeta}:")
        print(f"   Drive: {count_d} archivos")
        print(f"   Local: {count_l} archivos")
        
        if count_d != count_l:
            completo = False
            diferencia = count_d - count_l
            print(f"   DIFERENCIA: {diferencia:+d} archivos")
            
            # Mostrar faltantes
            nombres_d = {a['name'] for a in archivos_d}
            nombres_l = {a['name'] for a in archivos_l}
            
            faltantes = nombres_d - nombres_l
            if faltantes:
                print(f"   ❌ FALTANTES:")
                for archivo in sorted(faltantes):
                    print(f"      - {archivo}")
                    faltantes_totales.append(f"{subcarpeta}/{archivo}")
        
        print()
    
    # Conclusión
    print(f"{'='*100}")
    if completo and total_drive == total_local:
        print(f"✅ RESULTADO: COMPLETO")
        print(f"{'='*100}\n")
        return True
    else:
        print(f"❌ RESULTADO: INCOMPLETO")
        print(f"{'='*100}\n")
        print(f"🎯 TOTAL FALTANTES: {len(faltantes_totales)} archivos\n")
        
        if faltantes_totales:
            print("Lista completa de faltantes:")
            for faltante in faltantes_totales:
                print(f"  - {faltante}")
        
        print()
        return False

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("❌ Uso: python3 analizar_carpeta.py 'nombre_carpeta'")
        print("")
        print("Ejemplo: python3 analizar_carpeta.py '01 EdoMex Nancy G'")
        sys.exit(1)
    
    carpeta_nombre = sys.argv[1]
    exito = analizar_carpeta(carpeta_nombre)
    
    sys.exit(0 if exito else 1)
