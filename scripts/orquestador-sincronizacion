#!/usr/bin/env python3
"""Sincroniza estados de forma segura y procesa sus salidas en paralelo."""

import argparse
import concurrent.futures
import subprocess
import sys
from pathlib import Path

from pipeline_common import work_dir

CARPETAS = [
    "01 EdoMex Nancy G", "02 Hidalgo Diana", "03 Michoacán Jerónimo",
    "04 Querétaro Jackie", "05 Chiapas Diana", "06 Tabasco Jerónimo",
    "07 Tamaulipas Jackie", "08 Zacatecas Maca",
]
COMMON_FOLDER = "00 Bibliografía y normatividad federal"
WORK_DIR = work_dir()
SCRIPTS_DIR = Path(__file__).parent


def run(script, *arguments):
    return subprocess.run([sys.executable, str(SCRIPTS_DIR / script), *arguments], text=True, capture_output=True)


def process_state(state):
    result = run("pipeline-por-estado", state, "--skip-sync", "--skip-common")
    return state, result.returncode, result.stdout, result.stderr


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--run", action="store_true", help="Sincroniza y procesa los estados.")
    parser.add_argument("--workers", type=int, default=3)
    parser.add_argument("--rename-drive", action="store_true", help="Al finalizar, renombra en Drive los PDFs segun contenido_manifest.json.")
    args = parser.parse_args()
    if not args.run:
        print("Estados configurados:")
        print("\n".join(CARPETAS))
        print("Use --run para ejecutar la sincronización secuencial y el procesamiento paralelo.")
        return 0
    result = run("sincronizar-carpeta-drive", COMMON_FOLDER)
    print(result.stdout, end="")
    if result.returncode:
        print(result.stderr, file=sys.stderr, end="")
        return result.returncode
    result = run("analizar-y-versionar-pdfs", "--source", WORK_DIR / "09 FASP" / COMMON_FOLDER)
    print(result.stdout, end="")
    if result.returncode:
        print(result.stderr, file=sys.stderr, end="")
        return result.returncode
    for state in CARPETAS:
        result = run("sincronizar-carpeta-drive", state)
        print(result.stdout, end="")
        if result.returncode:
            print(result.stderr, file=sys.stderr, end="")
            return result.returncode
    errors = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, args.workers)) as executor:
        for state, code, stdout, stderr in executor.map(process_state, CARPETAS):
            print(stdout, end="")
            if code:
                errors += 1
                print(f"{state}: {stderr}", file=sys.stderr)
    if errors == 0 and args.rename_drive:
        result = run("actualizar-nombres-drive-desde-manifest")
        print(result.stdout, end="")
        if result.returncode:
            print(result.stderr, file=sys.stderr, end="")
            errors += 1
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
