#!/usr/bin/env python3
"""ETAPA 4: distribuye un corpus PDF mediante una publicación atómica."""

import argparse
import shutil
from datetime import datetime
from pathlib import Path

from pipeline_common import sha256_file, work_dir, write_json


WORK_DIR = work_dir()
CORPUS_DIR = WORK_DIR / "corpusintegrado"
ESTADOS_DIR = WORK_DIR / "corpus_por_estado_v2"
ESTADOS_MAP = {
    "MEX": "Estado_de_Mexico", "HID": "Hidalgo", "QRO": "Queretaro",
    "MIC": "Michoacan", "CHI": "Chiapas", "TAB": "Tabasco",
    "TAM": "Tamaulipas", "ZAC": "Zacatecas",
}


def category(filename: str) -> str:
    upper = filename.upper()
    if "TDR" in upper:
        return "01_TDR"
    if any(token in upper for token in ("PLAN", "REGLAMENTO", "LEY", "MANUAL", "GUIA", "TRANSPARENCIA", "RESPONSABILIDADES", "ORGANICA", "NORFED", "INFORME")):
        return "02_Normatividad_Estatal"
    return "00_Otros"


def distribute(source: Path, output: Path, dry_run: bool = False) -> dict:
    if not source.exists():
        raise FileNotFoundError(f"Corpus no existe: {source}")
    by_sha = {}
    for pdf in sorted(source.glob("*.pdf")):
        digest = sha256_file(pdf)
        current = by_sha.get(digest)
        if not current or len(pdf.name) < len(current.name):
            by_sha[digest] = pdf
    files = sorted(by_sha.values())
    if dry_run:
        return {"total_pdfs": len(files), "output": str(output)}

    staging = output.parent / f".{output.name}.staging-{datetime.now():%Y%m%d%H%M%S%f}"
    staging.mkdir(parents=True)
    shared = staging / "00_Compartida"
    shared.mkdir()
    stats = {name: 0 for name in ESTADOS_MAP.values()}
    shared_count = 0
    for pdf in files:
        matches = [name for code, name in ESTADOS_MAP.items() if f"_{code}_" in pdf.name.upper()]
        if len(matches) > 1:
            shutil.rmtree(staging)
            raise ValueError(f"PDF ambiguo para más de un estado: {pdf.name}")
        if not matches:
            destination = shared
            shared_count += 1
        else:
            state = matches[0]
            destination = staging / state / category(pdf.name)
            destination.mkdir(parents=True, exist_ok=True)
            stats[state] += 1
        shutil.copy2(pdf, destination / pdf.name)

    summary = {"timestamp": datetime.now().isoformat(), "total_pdfs": len(files), "shared": shared_count, "states": stats}
    write_json(staging / "manifest.json", summary)
    if output.exists():
        backup = output.parent / ".archive" / f"distribucion_backup_{datetime.now():%Y%m%d_%H%M%S}"
        backup.parent.mkdir(parents=True, exist_ok=True)
        output.replace(backup)
    staging.replace(output)
    return summary


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", type=Path, default=CORPUS_DIR)
    parser.add_argument("--output", type=Path, default=ESTADOS_DIR)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    try:
        summary = distribute(args.source, args.output, args.dry_run)
    except (OSError, ValueError) as error:
        print(f"ERROR: {error}")
        return 1
    print(f"ETAPA 4 completada: {summary['total_pdfs']} PDFs distribuidos")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
